# Optional. The unconfigured frontend uses honest empty market states.
# Set in Vercel project settings before deploying chain integrations.
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
# External HTTPS Nest API; leave unset to use the undeployed API response.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_BNB_RPC_URL=
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
