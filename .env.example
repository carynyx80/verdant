# Copy to .env; never commit secrets. API/worker scripts load it automatically.
DATABASE_URL=postgresql://verdant:local_development_only@localhost:5432/verdant
REDIS_URL=redis://127.0.0.1:6379
BNB_RPC_URL=
FACTORY_ADDRESS=
START_BLOCK=
# At least 32 characters; server-only. Never prefix with NEXT_PUBLIC_.
ADMIN_API_TOKEN=
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
# Production defaults to 0.0.0.0; development defaults to 127.0.0.1.
API_BIND_HOST=
LLM_API_KEY=
LLM_MODEL=
LLM_INPUT_MICROUSD_PER_MILLION=
LLM_OUTPUT_MICROUSD_PER_MILLION=
# For repository-root deployment, put frontend values in .env.local. apps/web/.env.local is used only for the optional subdirectory entry point.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
# Production defaults to 0.0.0.0; development defaults to 127.0.0.1.
API_BIND_HOST=
NEXT_PUBLIC_BNB_RPC_URL=
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
